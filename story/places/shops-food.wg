@# Basic authored hubs for shops, markets, and food venues.

@entry place.hub.market
  @scene place.market
  @place-key market
  @hub place
@endentry

:: place.market [place hub]
@kind place
@heading "Market"
@choices "Activities"

Stalls and shoppers fill {{place.name}}.

@choice browse "Browse the stalls" -> place.market
  @icon 🧺
@endchoice

@choice produce "Look over the fresh produce" -> place.market
  @icon 🥕
@endchoice

@choice leave "Leave" -> @leave-place
  @icon 🚪
  @time 1m
@endchoice

