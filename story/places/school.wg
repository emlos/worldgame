:: place.high-school.cafeteria
@heading "Cafeteria"

@if school.phase == "lunch" or school.phase == "break"
The cafeteria is open, and students are eating and socialising.
@else
The few students in the cafeteria are eating quietly. It seems kind of empty.
@endif

@choice before-school-taylor "Talk with Taylor before class" -> place.high-school.cafeteria
  
  @time 15m
  @when npc.taylor.present and not daily.school_before_taylor and school.phase != "class"
  @response
    Taylor giggles. "Have you heard that Prof. Sokolev has uploaded a mixtape on TwoYube? We should totally watch it together after class!"
  @endresponse
  @response
    You spend some time chatting with Taylor before class begins. {{npc.taylor.subject}} seems to be extra cheery today.
  @endresponse
  @response
    You and Taylor get a snack from the vending machine. It's a nice little break before class starts.
  @endresponse
  @change relationship taylor 2.5
  @effect daily-flag school_before_taylor true
@endchoice

@choice leave "Leave" -> place.high-school
  @time 1m
@endchoice

:: place.high-school.english-classroom
@heading "English Classroom"

@if school.phase == "lunch" or school.phase == "break"
The classroom is open, and students are studying and socialising.
@elseif school.phase == "class"
Everyone looks at you as you enter the classroom. The teacher is at the front of the room, and students are seated at their desks.
@endif

@choice wait-for-class "Wait for class" -> school.class.english
  
  @time-until school.nextClassStartsAt
  @enter-after-time
  @when school.phase != "class" and school.nextClass == "english"
@endchoice

@choice leave "Leave" -> place.high-school
  @time 1m
@endchoice

