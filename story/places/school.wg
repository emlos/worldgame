:: place.high-school.student-council-room
@heading "Student Council Office"

@if school.phase == "after-school"
"Yes?" the student council president asks as they look up from their paperwork.
@elseif school.phase == "class"
Nobody answers your knock. The office is closed during class time.
@else
  There's nobody here.
@endif

@choice leave "Leave" -> place.high-school
  @time 5m
@endchoice

:: place.high-school.nurse-office
@heading "School Nurse's Office"

@if npc.caro.present
  @if school.phase == "class"
    Nobody answers your knock. The office is closed during class time.
  @else
    Nurse Caro looks up from {{npc.caro.dependent}} paperwork.
  @endif
@else
  The office is empty. You can see the nurse's chair pushed back from the desk.
@endif


@choice school-nurse-checkup "Ask the school nurse for a checkup" -> place.high-school.nurse-office
  @time 2m
  @when npc.caro.present and school.phase != "class"
  @response
    The nurse looks you over and takes your vitals. "Everything looks good," {{npc.caro.subject}} says, "but make sure to get enough sleep and eat well!"
  @endresponse
@endchoice

@choice leave "Leave" -> place.high-school
  @time 2m
@endchoice


