  @event-pool school.class.math
  
  @time-until school.nextBoundaryAt
  @when npc.taylor.present
  @effect attendance math 1
  @change relationship taylor 1
@endchoice

@choice math-3-study "Study hard" -> @exit
  @event-pool school.class.math
  @time-until school.nextBoundaryAt
  @preview grade 1 "+Mathematics grade"
  @effect attendance math 1
  @effect grade math 1
