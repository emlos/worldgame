@# Authored hubs for dynamically placed NPC residences. Homes start locked;
@# reveal them with @unlock place home_<npc-id>.

@entry place.hub.home-taylor
  @scene place.home-taylor
  @place-key home_taylor
  @hub place
@endentry

:: place.home-taylor [place hub]
@kind place
@heading "Taylor's home"
@choices "Activities"

You are inside {{place.name}}.

@choice relax "Relax in the living room" -> place.home-taylor
  @icon 🛋️
@endchoice

@choice bookshelf "Look over Taylor's bookshelf" -> place.home-taylor
  @icon 📚
@endchoice

@choice leave "Leave" -> @leave-place
  @icon 🚪
  @time 1m
@endchoice

