@# Basic authored hubs for luxury shops, clubs, hospitality, and leisure.

@entry place.hub.jewelry-store
  @scene place.jewelry-store
  @place-key jewelry_store
  @hub place
@endentry

:: place.jewelry-store [place hub]
@kind place
@heading "Jewelry Store"
@choices "Activities"

Glass cases sparkle beneath the lights of {{place.name}}.

@choice cases "Browse the display cases" -> place.jewelry-store
  @icon 💎
@endchoice

@choice assistant "Speak to an assistant" -> place.jewelry-store
  @icon 🗣️
@endchoice

@choice leave "Leave" -> @leave-place
  @icon 🚪
  @time 1m
@endchoice

