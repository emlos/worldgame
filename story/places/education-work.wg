  @preview grade 1 "+Mathematics grade"
  @effect attendance math 1
  @effect grade math 1
@endchoice
@endif

@elseif school.phase == "class" and school.subjectId == "history"

History class is in progress. This is segment {{school.segment}} of {{school.segmentCount}}.

@if school.segment == 1
@choice history-1-taylor "Interact with Taylor" -> place.high-school
  @icon 💬
