@# Basic authored hubs for schools, workplaces, and emergency services.

@entry place.hub.primary-school
  @scene place.primary-school
  @place-key primary_school
  @hub place
@endentry

:: place.primary-school [place hub]
@kind place
@heading "Primary School"
@choices "Activities"

Children's work and school notices decorate {{place.name}}.

@choice reception "Visit the school office" -> place.primary-school
  @icon 🏫
@endchoice

@choice notices "Read the noticeboard" -> place.primary-school
  @icon 📌
@endchoice

@choice leave "Leave" -> @leave-place
  @icon 🚪
  @time 1m
@endchoice

@entry place.hub.middle-school
  @scene place.middle-school
  @place-key middle_school
  @hub place
@endentry

:: place.middle-school [place hub]
@kind place
@heading "Middle School"
@choices "Activities"

Class schedules and club posters cover the walls of {{place.name}}.

@choice reception "Visit the school office" -> place.middle-school
  @icon 🏫
@endchoice

@choice clubs "Check the club notices" -> place.middle-school
  @icon 📌
@endchoice

@choice leave "Leave" -> @leave-place
  @icon 🚪
  @time 1m
@endchoice

@entry place.hub.high-school
  @scene place.high-school
  @place-key high_school
  @hub place
@endentry

:: place.high-school [place hub]
@kind place
@heading "High School"
@choices "Travel"


@choicegroup current-activities "Current Activities"

@if school.phase == "before_school"

The halls of {{place.name}} are open, though lessons have not begun yet. You can see groups of students move in the hallways.

@choice before-school-taylor "Talk with Taylor before class" -> place.high-school
  @icon 💬
  @time 5m
  @when npc.taylor.present and not daily.school_before_taylor
  @effect relationship taylor 0.003
  @effect daily-flag school_before_taylor true
@endchoice

@choice wait-for-first-class "Wait for the first class" -> place.high-school
  @icon ⏳
  @time-until school.nextBoundaryAt
@endchoice

@elseif school.phase == "class" and school.subjectId == "english"

English class is in progress. You can attend during its opening segment or keep exploring the school.

@choice attend-english "Attend English class" -> school.class.english
  @icon 📖
  @when school.segment == 1
@endchoice

@elseif school.phase == "class" and school.subjectId == "math"

Mathematics class is in progress. You can attend during its opening segment or keep exploring the school.

@choice attend-math "Attend Mathematics class" -> school.class.math
  @icon 🧮
  @when school.segment == 1
@endchoice

@elseif school.phase == "class" and school.subjectId == "history"

History class is in progress. You can attend during its opening segment or keep exploring the school.

@choice attend-history "Attend History class" -> school.class.history
  @icon 📜
  @when school.segment == 1
@endchoice

@elseif school.phase == "lunch"

Lunch break is underway. The cafeteria is open until afternoon classes begin.

@choice lunch-cafeteria "Go to the cafeteria" -> place.high-school
  @icon 🍽️
  @time-until school.nextBoundaryAt
@endchoice

@choice lunch-wait "Wait for the next class" -> place.high-school
  @icon ⏳
  @time-until school.nextBoundaryAt
@endchoice

@elseif school.phase == "class" and school.subjectId == "science"

Science class is in progress. You can attend during its opening segment or keep exploring the school.

@choice attend-science "Attend Science class" -> school.class.science
  @icon 🔬
  @when school.segment == 1
@endchoice

@elseif school.phase == "class" and school.subjectId == "art"

Art class is in progress. You can attend during its opening segment or keep exploring the school.

@choice attend-art "Attend Art class" -> school.class.art
  @icon 🎨
  @when school.segment == 1
@endchoice

@elseif school.phase == "class" and school.subjectId == "physical_education"

Physical education is in progress. You can attend during its opening segment or keep exploring the school.

@choice attend-physical-education "Attend Physical Education" -> school.class.physical-education
  @icon 🏃
  @when school.segment == 1
@endchoice

@elseif school.phase == "break"

There is a short break before the next class begins.

@choice break-cafeteria "Go to the cafeteria" -> place.high-school
  @icon 🍎
  @time-until school.nextBoundaryAt
@endchoice

@choice break-wait "Wait for the next class" -> place.high-school
  @icon ⏳
  @time-until school.nextBoundaryAt
@endchoice

@elseif school.phase == "after_school"

Lessons are over, but {{place.name}} remains open until 17:00.

@choice after-school-wait "Stay until school closes" -> place.high-school
  @icon ⏳
  @time-until school.nextBoundaryAt
@endchoice

@elseif school.phase == "no_school"

There are no lessons today, though the administrative areas remain open.

@choice no-school-office "Visit the school office" -> place.high-school
  @icon 🏫
  @time 15m
@endchoice

@choice no-school-notices "Read the school notices" -> place.high-school
  @icon 📌
  @time 5m
@endchoice

@else

The school has closed for the day.

@endif

@endchoicegroup

@choicegroup activities "Activities"

@choice cafeteria-room "Go to the cafeteria" -> place.high-school.cafeteria
  @icon 🍽️
  @time 1m
@endchoice

@choice math-classroom "Go to the math classroom" -> place.high-school.math-classroom
  @icon 🧮
  @time 1m
@endchoice

@choice english-classroom "Go to the english classroom" -> place.high-school.english-classroom
  @icon 📖
  @time 1m
@endchoice

@choice history-classroom "Go to the history classroom" -> place.high-school.history-classroom
  @icon 📜
  @time 1m
@endchoice

@choice science-classroom "Go to the science classroom" -> place.high-school.science-classroom
  @icon 🔬
  @time 2m
@endchoice

@choice art-classroom "Go to the art classroom" -> place.high-school.art-classroom
  @icon 🎨
  @time 2m
@endchoice

@choice school-gym "Go to the school gym" -> place.high-school.gym
  @icon 🏃
  @time 5m
@endchoice

@choice student-council-room "Visit the student council office" -> place.high-school.student-council-room
  @icon 🏫
  @time 5m
@endchoice

@endchoicegroup


@choice leave-school "Leave" -> @leave-place
  @icon 🚪
  @time 1m
@endchoice


@sequence school.class.english -> @exit
@heading "English Class"
@choices "Class activity"

@passage segment-1

The first segment of English class begins.

@choice english-1-taylor "Interact with Taylor" -> .segment-2
  @icon 💬
  @time-until school.nextBoundaryAt
  @when npc.taylor.present
  @effect attendance english 1
  @effect relationship taylor 0.003
@endchoice

@choice english-1-study "Study hard" -> .segment-2
  @icon 📖
  @time-until school.nextBoundaryAt
  @preview grade 1 "+English grade"
  @effect attendance english 1
  @effect grade english 1
@endchoice

@passage segment-2

English class continues into its second segment.

@choice english-2-taylor "Interact with Taylor" -> .segment-3
  @icon 💬
  @time-until school.nextBoundaryAt
  @when npc.taylor.present
  @effect attendance english 1
  @effect relationship taylor 0.003
@endchoice

@choice english-2-study "Study hard" -> .segment-3
  @icon 📖
  @time-until school.nextBoundaryAt
  @preview grade 1 "+English grade"
  @effect attendance english 1
  @effect grade english 1
@endchoice

@passage segment-3

The final segment of English class gets underway.

@choice english-3-taylor "Interact with Taylor" -> @exit
  @icon 💬
  @time-until school.nextBoundaryAt
  @when npc.taylor.present
  @effect attendance english 1
  @effect relationship taylor 0.003
@endchoice

@choice english-3-study "Study hard" -> @exit
  @icon 📖
  @time-until school.nextBoundaryAt
  @preview grade 1 "+English grade"
  @effect attendance english 1
  @effect grade english 1
@endchoice

@endsequence

