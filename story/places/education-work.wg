@# Basic authored hubs for schools, workplaces, and emergency services.

@entry place.hub.primary-school
  @scene place.primary-school
  @place-key primary_school
  @hub place
@endentry

:: place.primary-school [place hub]
@kind place
@heading "Primary School"
@choices "Activities"

Children's work and school notices decorate {{place.name}}.

@choice reception "Visit the school office" -> place.primary-school
  @icon 🏫
@endchoice

@choice notices "Read the noticeboard" -> place.primary-school
  @icon 📌
@endchoice

@choice leave "Leave" -> @leave-place
  @icon 🚪
  @time 1m
@endchoice

