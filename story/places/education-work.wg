:: place.high-school.cafeteria
@heading "Cafeteria"

@if school.phase == "lunch" or school.phase == "break"
The cafeteria is open, and students are eating and socialising.
@else
The few students in the cafeteria are eating quietly. It seems kind of empty.
@endif

@choice socialize "Chat with Taylor" -> place.high-school.cafeteria
  @icon 💬
  @time 15m
  @when npc.taylor.present and school.phase != "class"
  @effect relationship taylor 0.003
  @preview relationship 0.003 "+Relationship"
@endchoice

@choice leave "Leave" -> place.high-school
  @time 1m
@endchoice

:: place.high-school.english-classroom
@heading "English Classroom"

@if school.phase == "lunch" or school.phase == "break"
The classroom is open, and students are studying and socialising.
@else
Everyone looks at you as you enter the classroom. The teacher is at the front of the room, and students are seated at their desks.
@endif

@choice leave "Leave" -> place.high-school
  @time 1m
@endchoice

