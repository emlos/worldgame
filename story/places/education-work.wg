@entry place.hub.high-school
  @scene place.high-school
  @place-key high_school
  @hub place
@endentry

:: place.high-school [place hub]
@kind place
@heading "High School"
@choices "Activities"

@if school.phase == "before_school"

The halls of {{place.name}} are open, though lessons have not begun yet.

@choice before-school-taylor "Talk with Taylor before class" -> place.high-school
  @icon 💬
  @time 5m
  @when npc.taylor.present and not daily.school_before_taylor
  @effect relationship taylor 0.003
  @effect daily-flag school_before_taylor true
@endchoice

@choice wait-for-first-class "Wait for the first class" -> place.high-school
  @icon ⏳
  @time-until school.nextBoundaryAt
@endchoice

@choice leave-before-school "Leave" -> @leave-place
  @icon 🚪
  @time 1m
@endchoice

@elseif school.phase == "class" and school.subjectId == "english"

English class is in progress. This is segment {{school.segment}} of {{school.segmentCount}}.

@if school.segment == 1
@choice english-1-taylor "Interact with Taylor" -> place.high-school
  @icon 💬
  @time 15m
  @when npc.taylor.present
  @effect attendance english 1
  @effect relationship taylor 0.003
@endchoice
@choice english-1-study "Study hard" -> place.high-school
  @icon 📖
  @time 15m
  @preview grade 1 "+English grade"
  @effect attendance english 1
  @effect grade english 1
@endchoice
@elseif school.segment == 2
@choice english-2-taylor "Interact with Taylor" -> place.high-school
  @icon 💬
  @time 15m
  @when npc.taylor.present
  @effect attendance english 1
  @effect relationship taylor 0.003
@endchoice
@choice english-2-study "Study hard" -> place.high-school
  @icon 📖
  @time 15m
  @preview grade 1 "+English grade"
  @effect attendance english 1
  @effect grade english 1
@endchoice
@else
@choice english-3-taylor "Interact with Taylor" -> place.high-school
  @icon 💬
  @time 15m
  @when npc.taylor.present
  @effect attendance english 1
  @effect relationship taylor 0.003
@endchoice
@choice english-3-study "Study hard" -> place.high-school
  @icon 📖
  @time 15m
  @preview grade 1 "+English grade"
  @effect attendance english 1
  @effect grade english 1
@endchoice
@endif

@elseif school.phase == "class" and school.subjectId == "math"

Mathematics class is in progress. This is segment {{school.segment}} of {{school.segmentCount}}.

@if school.segment == 1
@choice math-1-taylor "Interact with Taylor" -> place.high-school
  @icon 💬
  @time 15m
  @when npc.taylor.present
  @effect attendance math 1
  @effect relationship taylor 0.003
@endchoice
@choice math-1-study "Study hard" -> place.high-school
  @icon 🧮
  @time 15m
  @preview grade 1 "+Mathematics grade"
  @effect attendance math 1
  @effect grade math 1
@endchoice
@elseif school.segment == 2
@choice math-2-taylor "Interact with Taylor" -> place.high-school
  @icon 💬
  @time 15m
  @when npc.taylor.present
  @effect attendance math 1
  @effect relationship taylor 0.003
@endchoice
@choice math-2-study "Study hard" -> place.high-school
  @icon 🧮
  @time 15m
  @preview grade 1 "+Mathematics grade"
  @effect attendance math 1
  @effect grade math 1
@endchoice
@else
@choice math-3-taylor "Interact with Taylor" -> place.high-school
  @icon 💬
  @time 15m
  @when npc.taylor.present
  @effect attendance math 1
  @effect relationship taylor 0.003
@endchoice
@choice math-3-study "Study hard" -> place.high-school
  @icon 🧮
