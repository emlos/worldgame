@# Basic authored hubs for home, civic, transport, and everyday service places.

@entry place.hub.player-home
  @scene place.player-home
  @place-key player_home
  @hub place
@endentry

:: place.player-home [place hub]
@kind place
@heading "Home"
@choices "Activities"

You are back in the privacy of {{place.name}}.

@choice rest "Rest for a while" -> place.player-home
  @icon 🛋️
@endchoice

@choice chores "Do some chores" -> place.player-home
  @icon 🧹
@endchoice

@choice leave "Leave" -> @leave-place
  @icon 🚪
  @time 1m
@endchoice

