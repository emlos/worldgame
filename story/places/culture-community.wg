@# Basic authored hubs for recreation, culture, and community places.

@entry place.hub.park
  @scene place.park
  @place-key park
  @hub place
@endentry

:: place.park [place hub]
@kind place
@heading "Park"
@choices "Activities"

Paths wind between the green spaces of {{place.name}}.

@choice walk "Walk through the park" -> place.park
  @icon 🚶
@endchoice

@choice relax "Relax on the grass" -> place.park
  @icon 🌿
@endchoice

@choice leave "Leave" -> @leave-place
  @icon 🚪
  @time 1m
@endchoice

