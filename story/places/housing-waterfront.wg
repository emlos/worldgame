@# Basic authored hubs for housing and waterfront places.

@entry place.hub.apartment-complex
  @scene place.apartment-complex
  @place-key apartment_complex
  @hub place
@endentry

:: place.apartment-complex [place hub]
@kind place
@heading "Apartment Complex"
@choices "Activities"

Mailboxes and apartment directories line the entrance of {{place.name}}.

@choice directory "Check the apartment directory" -> place.apartment-complex
  @icon 🏢
@endchoice

@choice courtyard "Look around the shared courtyard" -> place.apartment-complex
  @icon 🌿
@endchoice

@choice leave "Leave" -> @leave-place
  @icon 🚪
  @time 1m
@endchoice

