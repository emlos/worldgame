@# Authored reminders are activated and cleared by story effects.
@reminder vega_station
  @text "Vega expects you at the station at [warning]12:00[/warning] today."
  @priority 200
@endreminder

@reminder school_project_last_day
  @text "Today is the last day to present your school project!"
  @tone warning
  @priority 210
@endreminder

@reminder home_rent_notice_1
  @text "You should make your way to the civil office as soon as possible."
  @tone warning
  @priority 999
@endreminder

@reminder rent_due
  @text "You have overdue rent. Kim accepts £200 payments at the office."
  @tone warning
  @priority 220
@endreminder

@reminder cafe_job
  @text "You can work one-hour shifts at the cafe from 07:00. The last shift starts at 21:00."
  @priority 100
@endreminder
