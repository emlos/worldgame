@# Engine-reserved interrupt pool. Conditions are edge-triggered by the runtime.

:: interrupt.exhaustion.school -> place.high-school.nurse-office
  @pool interrupt
  @place-key high_school
  @# The player panel displays energy as whole units by rounding down, so any
  @# remaining fraction below 1 is already presented as zero to the player.
  @when player.energy < 1
  @priority 100

  @passage collapse

  You're so tired... you can't stay awake.

  @choice "Next" -> .wake
    @time 1h..3h rest
  @endchoice

  @passage wake

  @effect relocate nearest-place high_school

  You wake up in the nurse's office, in one of the beds.

  @next -> place.high-school.nurse-office
:: interrupt.exhaustion.home -> @exit
  @pool interrupt
  @place-key player_home
  @when player.energy < 1
  @priority 100

  @passage collapse

  You're so tired... you can't stay awake.

  @choice "Next" -> .wake
    @time 1h..3h rest
  @endchoice

  @passage wake

  @effect relocate home

  You wake up on the floor of your home.

  @next -> @exit
:: interrupt.exhaustion.hospital -> @exit
  @pool interrupt
  @when player.energy < 1

  @passage collapse

  You're so tired... you can't stay awake.

  @choice "Next" -> .wake
    @time 1h..3h rest
  @endchoice

  @passage wake

  @effect relocate nearest-place hospital

  You wake up in the hospital, on one of the spare beds.

  @next -> @exit
