{
  "comments": { "lineComment": "@#" },
  "brackets": [["[", "]"], ["(", ")"], ["{{", "}}"]],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "[", "close": "]", "notIn": ["string", "comment"] },
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "{{", "close": "}}", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["\"", "\""], ["[", "]"], ["(", ")"], ["{{", "}}"]],
  "folding": {
    "markers": {
      "start": "^\\s*@(entry|sequence|choice|choicegroup|if|success|failure|response|onenter)\\b",
      "end": "^\\s*@(endentry|endsequence|endchoice|endchoicegroup|endif|endsuccess|endfailure|endresponse|endonenter)\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*@(entry|sequence|choice|choicegroup|if|elseif|else|success|failure|response|onenter)\\b.*$",
    "decreaseIndentPattern": "^\\s*@(endentry|endsequence|endchoice|endchoicegroup|endif|endsuccess|endfailure|endresponse|endonenter|elseif|else)\\b.*$"
  }
}
