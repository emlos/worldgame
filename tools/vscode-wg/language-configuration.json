{
  "comments": {
    "lineComment": "@#"
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "{{",
      "}}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "{{",
      "close": "}}",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "\"",
      "\""
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "{{",
      "}}"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*@(journal|chat|message|reminder|location|choice|choicegroup|if|success|failure|response|random|onenter)\\b",
      "end": "^\\s*@(endjournal|endchat|endmessage|endreminder|endlocation|endchoice|endchoicegroup|endif|endsuccess|endfailure|endresponse|endrandom|endonenter)\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*@(journal|chat|message|reminder|location|choice|choicegroup|if|success|failure|response|random|onenter|elseif|else|or)\\b.*$",
    "decreaseIndentPattern": "^\\s*@(endjournal|endchat|endmessage|endreminder|endlocation|endchoice|endchoicegroup|endif|endsuccess|endfailure|endresponse|endrandom|endonenter|elseif|else|or)\\b.*$"
  }
}
