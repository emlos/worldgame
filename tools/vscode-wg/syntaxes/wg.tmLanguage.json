{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Worldgame WG",
  "scopeName": "source.wg",
  "patterns": [
    { "include": "#comments" },
    { "include": "#escaped-markers" },
    { "include": "#scene-header" },
    { "include": "#entry-header" },
    { "include": "#sequence-header" },
    { "include": "#passage-header" },
    { "include": "#next-directive" },
    { "include": "#choicegroup-header" },
    { "include": "#choice-header" },
    { "include": "#outcome-header" },
    { "include": "#condition-directives" },
    { "include": "#effect-directives" },
    { "include": "#property-directives" },
    { "include": "#block-directives" },
    { "include": "#interpolation" },
    { "include": "#unknown-directives" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.wg", "match": "^\\s*@#.*$" }
      ]
    },
    "escaped-markers": {
      "patterns": [
        {
          "match": "^(\\s*)(\\\\)(?=@|::)",
          "captures": { "2": { "name": "constant.character.escape.wg" } }
        }
      ]
    },
    "scene-header": {
      "patterns": [
        {
          "name": "meta.scene.header.wg",
          "match": "^(\\s*)(::)(\\s+)([a-z0-9_][a-z0-9_.-]*)(?:\\s+(\\[)([^\\]]*)(\\]))?\\s*$",
          "captures": {
            "2": { "name": "keyword.control.section.wg" },
            "4": { "name": "entity.name.section.wg" },
            "5": { "name": "punctuation.definition.annotation.begin.wg" },
            "6": { "name": "storage.modifier.scene-tag.wg" },
            "7": { "name": "punctuation.definition.annotation.end.wg" }
          }
        }
      ]
    },
    "entry-header": {
      "patterns": [
        {
          "name": "meta.entry.header.wg",
          "match": "^(\\s*)(@entry)\\s+([a-z0-9_][a-z0-9_.-]*)\\s*$",
          "captures": {
            "2": { "name": "keyword.control.block.begin.wg" },
            "3": { "name": "entity.name.type.entry.wg" }
          }
        }
      ]
    },
    "sequence-header": {
      "patterns": [
        {
          "name": "meta.sequence.header.wg",
          "match": "^(\\s*)(@sequence)\\s+([a-z][a-z0-9_.-]*)\\s+(->)\\s+(@exit|[a-z][a-z0-9_.-]*)\\s*$",
          "captures": {
            "2": { "name": "keyword.control.block.begin.wg" },
            "3": { "name": "entity.name.type.sequence.wg" },
            "4": { "name": "keyword.operator.arrow.wg" },
            "5": { "name": "entity.name.section.reference.wg" }
          }
        }
      ]
    },
    "passage-header": {
      "patterns": [
        {
          "name": "meta.passage.header.wg",
          "match": "^(\\s*)(@passage)\\s+([a-z][a-z0-9_-]*)\\s*$",
          "captures": {
            "2": { "name": "keyword.control.section.wg" },
            "3": { "name": "entity.name.section.wg" }
          }
        }
      ]
    },
    "next-directive": {
      "patterns": [
        {
          "name": "meta.next.directive.wg",
          "match": "^(\\s*)(@next)(?:\\s+(\"(?:\\\\.|[^\"\\\\])*\"))?(?:\\s+(->)\\s+(@exit|\\.[a-z][a-z0-9_-]*|[a-z][a-z0-9_.-]*))?\\s*$",
          "captures": {
            "2": { "name": "keyword.control.flow.wg" },
            "3": { "name": "string.quoted.double.wg" },
            "4": { "name": "keyword.operator.arrow.wg" },
            "5": { "name": "entity.name.section.reference.wg" }
          }
        }
      ]
    },
    "choice-header": {
      "patterns": [
        {
          "name": "meta.choice.header.wg",
          "match": "^(\\s*)(@choice)\\s+([a-z0-9_][a-z0-9_.-]*)\\s+(\"(?:\\\\.|[^\"\\\\])*\")(?:\\s+(->)\\s+(@exit|@leave-place|\\.[a-z][a-z0-9_-]*|[a-z0-9_][a-z0-9_.-]*))?\\s*$",
          "captures": {
            "2": { "name": "keyword.control.block.begin.wg" },
            "3": { "name": "entity.name.function.choice.wg" },
            "4": { "name": "string.quoted.double.wg" },
            "5": { "name": "keyword.operator.arrow.wg" },
            "6": { "name": "entity.name.section.reference.wg" }
          }
        }
      ]
    },
    "choicegroup-header": {
      "patterns": [
        {
          "name": "meta.choicegroup.header.wg",
          "match": "^(\\s*)(@choicegroup)\\s+([a-z][a-z0-9_.-]*)\\s+(\"(?:\\\\.|[^\"\\\\])*\")\\s*$",
          "captures": {
            "2": { "name": "keyword.control.block.begin.wg" },
            "3": { "name": "entity.name.type.choicegroup.wg" },
            "4": { "name": "string.quoted.double.wg" }
          }
        }
      ]
    },
    "outcome-header": {
      "patterns": [
        {
          "name": "meta.choice.outcome.header.wg",
          "match": "^(\\s*)(@(success|failure))\\s+(->)\\s+(@exit|@leave-place|\\.[a-z][a-z0-9_-]*|[a-z0-9_][a-z0-9_.-]*)\\s*$",
          "captures": {
            "2": { "name": "keyword.control.block.begin.wg" },
            "4": { "name": "keyword.operator.arrow.wg" },
            "5": { "name": "entity.name.section.reference.wg" }
          }
        }
      ]
    },
    "condition-directives": {
      "patterns": [
        {
          "name": "meta.expression.directive.wg",
          "begin": "^(\\s*)(@(if|elseif|when|require))\\b",
          "beginCaptures": { "2": { "name": "keyword.control.conditional.wg" } },
          "end": "$",
          "patterns": [{ "include": "#expression" }]
        }
      ]
    },
    "effect-directives": {
      "patterns": [
        {
          "name": "meta.effect.directive.wg",
          "begin": "^(\\s*)(@effect)\\b",
          "beginCaptures": { "2": { "name": "keyword.control.effect.wg" } },
          "end": "$",
          "patterns": [
            { "name": "storage.type.effect.wg", "match": "\\b(?:set|add|flag|daily-flag|relationship|money|skill|stat|grade|attendance)\\b" },
            { "include": "#expression" }
          ]
        }
      ]
    },
    "property-directives": {
      "patterns": [
        {
          "name": "meta.property.directive.wg",
          "begin": "^(\\s*)(@(kind|heading|choices|scene|place-key|place-tag|location-tag|hub|offer|label|icon|hub-text|auto|priority|chance|weight|time|time-until|warning|preview|check))\\b",
          "beginCaptures": { "2": { "name": "keyword.other.directive.wg" } },
          "end": "$",
          "patterns": [{ "include": "#expression" }]
        }
      ]
    },
    "block-directives": {
      "patterns": [
        {
          "name": "keyword.control.block.wg",
          "match": "^\\s*(@(?:else|endif|endentry|endchoice|endchoicegroup|endsequence|success|endsuccess|failure|endfailure|onenter|endonenter))\\s*$"
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.wg",
          "begin": "\\{\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.wg" } },
          "end": "\\}\\}",
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.wg" } },
          "patterns": [
            {
              "match": "(\\|)(cap)\\b",
              "captures": {
                "1": { "name": "punctuation.separator.modifier.wg" },
                "2": { "name": "support.function.modifier.wg" }
              }
            },
            { "include": "#expression" }
          ]
        }
      ]
    },
    "unknown-directives": {
      "patterns": [
        {
          "name": "invalid.illegal.unknown-directive.wg",
          "match": "^\\s*(@[a-z][a-z-]*)\\b"
        }
      ]
    },
    "expression": {
      "patterns": [
        { "name": "string.quoted.double.wg", "match": "\"(?:\\\\.|[^\"\\\\])*\"" },
        { "name": "constant.numeric.duration.wg", "match": "\\b(?:[0-9]+(?:\\.[0-9]+)?[hms])+\\b" },
        { "name": "constant.numeric.percentage.wg", "match": "\\b[0-9]+(?:\\.[0-9]+)?%(?![A-Za-z0-9_])" },
        { "name": "constant.numeric.wg", "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b" },
        { "name": "constant.language.wg", "match": "\\b(?:true|false|null)\\b|@(?:exit|leave-place)\\b" },
        { "name": "variable.other.object.wg", "match": "\\b(?:story|player|npc|flags|daily|time|school|place|location)(?:\\.[A-Za-z_][A-Za-z0-9_-]*)+\\b" },
        { "name": "keyword.operator.logical.wg", "match": "\\b(?:and|or|not|in)\\b" },
        { "name": "keyword.operator.comparison.wg", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.arithmetic.wg", "match": "[+*/%-]" },
        { "name": "punctuation.definition.list.wg", "match": "[\\[\\],()]" },
        { "name": "variable.other.identifier.wg", "match": "\\b[A-Za-z_][A-Za-z0-9_.-]*\\b" }
      ]
    }
  }
}
